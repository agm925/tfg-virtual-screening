# Copia este archivo como ".env" y rellena los valores reales.
# El archivo .env NO debe subirse a git (añádelo a .gitignore).

# --- Autenticacion (JWT) ---
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacio, el backend genera una clave aleatoria en cada arranque
# (valido para desarrollo puntual, pero invalida todas las sesiones activas
# cada vez que el proceso se reinicia).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Base de datos ---
# Por defecto (si no se define) cae a SQLite local: sqlite:///./tfg_virtual_screening.db
# En local con `docker compose up`, DATABASE_URL se construye sola a partir de las 3 vars
# de abajo (ver docker-compose.yml) — no hace falta definirla aparte para levantar los contenedores.
DATABASE_URL=postgresql://usuario:password@localhost:5432/tfg_virtual_screening
POSTGRES_USER=tfg_user
POSTGRES_PASSWORD=tfg_password
POSTGRES_DB=tfg_virtual_screening

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=1

# Credenciales del panel Flower (usuario:contraseña). Flower puede revocar
# tareas, así que CAMBIA esto antes de exponerlo a nadie.
FLOWER_BASIC_AUTH=admin:admin

# --- CORS ---
# Orígenes que pueden llamar a la API desde un navegador, separados por comas.
# Normalmente NO hace falta tocarlo: la SPA se sirve bajo el mismo origen que
# la API (proxy /api/), así que sus peticiones no son cross-origin. Solo es
# necesario si sirves el frontend desde un dominio distinto al del backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Modo de ejecución de algoritmos: "local" (subprocess) o "slurm" (clúster Picasso, SCBI-UMA) ---
EXECUTION_MODE=local

# Segundos máximos por algoritmo en modo local antes de abortarlo (30 min por
# defecto). Evita que un script colgado bloquee la cola de Celery. El
# equivalente en modo slurm es SLURM_JOB_TIMEOUT.
ALGORITMO_TIMEOUT=1800

# --- SLURM: simulación local vs. Picasso real ---
#
# SIMULACIÓN LOCAL (perfil "slurm" de docker-compose). Levanta un clúster SLURM
# de un nodo en un contenedor y ejercita el mismo código que Picasso — SSH,
# SFTP, sbatch, sacct — sin credenciales del centro ni esperas en cola real:
#
#     docker compose --profile slurm up --build
#
# con estos valores:
#     EXECUTION_MODE=slurm
#     SLURM_HOST=slurm          <- nombre del servicio en el compose
#     SLURM_USER=tfg
#     SLURM_PASSWORD=tfg
#     SLURM_SSH_KEY_PATH=       <- vacío: la simulación usa contraseña
#     SLURM_REMOTE_DIR=/home/tfg/tfg_virtual_screening_jobs
#     SLURM_PARTITION=generic
#     SLURM_MEM=2G              <- OBLIGATORIO bajarlo: el nodo simulado declara
#                                  RealMemory=3000 MB, así que el 4G por defecto
#                                  se rechazaría con "requested node
#                                  configuration is not available"
#
# PICASSO REAL: usa los valores de abajo, con clave SSH en vez de contraseña.

# --- SLURM / Clúster Picasso (SCBI, Universidad de Málaga) — solo se usan si EXECUTION_MODE=slurm ---
SLURM_HOST=picasso.scbi.uma.es
SLURM_PORT=22
SLURM_USER=tu_usuario_del_cluster
# Deja SLURM_SSH_KEY_PATH vacío si vas a autenticar con SLURM_PASSWORD (no recomendado); si usas clave, deja SLURM_PASSWORD vacío
SLURM_SSH_KEY_PATH=C:/Users/tu_usuario/.ssh/id_rsa_picasso
SLURM_PASSWORD=
SLURM_REMOTE_DIR=/home/tu_usuario_del_cluster/tfg_virtual_screening_jobs
SLURM_PARTITION=generic
SLURM_TIME_LIMIT=00:30:00
SLURM_CPUS_PER_TASK=1
SLURM_MEM=4G
SLURM_MODULES=miniconda
SLURM_CONDA_ENV=tfg-screening
SLURM_POLL_INTERVAL=10
SLURM_JOB_TIMEOUT=3600

# --- Correo (Gmail con contraseña de aplicación) ---
# Instrucciones para Gmail:
#   1. Activa la verificación en 2 pasos en tu cuenta Google.
#   2. Ve a https://myaccount.google.com/apppasswords
#   3. Crea una contraseña de aplicación (nombre: "VirtualScreening").
#   4. Pega los 16 caracteres que te da en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=tu_correo@gmail.com
