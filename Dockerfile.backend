FROM python:3.11-slim

# Dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    openbabel \
    libopenbabel-dev \
    wget \
    curl \
    openssh-client \
    libxrender1 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Smina — no está empaquetado en Debian, así que se descarga la build estática
# oficial durante la construcción de la imagen.
#
# Antes esto era `COPY bin/smina`, con el binario versionado en el repositorio.
# El fichero que había commiteado NO era un binario: eran 9 bytes con el texto
# "Not Found", restos de una descarga fallida. Como el COPY y el chmod +x
# funcionaban igual, shutil.which("smina") lo encontraba, verificar_smina()
# daba el visto bueno, y el fallo aparecía mucho después como un
# "Exec format error" imposible de relacionar con la causa.
#
# La verificación del checksum es la pieza que faltaba: si la descarga falla o
# devuelve una página de error, sha256sum aborta la construcción en el acto en
# vez de dejar pasar basura. El `smina --version` final es una prueba de humo:
# una imagen no puede construirse con un smina que no ejecuta.
ARG SMINA_URL="https://sourceforge.net/projects/smina/files/smina.static/download"
ARG SMINA_SHA256="ffe5e1e78c947f76b0df8805e2c54383d0bbaf2e827a633b643a708cf682a958"
RUN curl -fsSL -o /usr/local/bin/smina "${SMINA_URL}" \
    && echo "${SMINA_SHA256}  /usr/local/bin/smina" | sha256sum -c - \
    && chmod +x /usr/local/bin/smina \
    && smina --version

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install flower==2.0.1

COPY . .

# Ningún secreto en la imagen (spec 006). Lo excluye el .dockerignore, pero si
# alguien lo rompe, la construcción falla aquí en vez de dejar pasar la clave:
# antes, la clave privada del clúster de secrets/ssh/ acababa en
# /app/secrets/ssh/, legible por los algoritmos subidos (corren como nobody).
# La plataforma no la necesita en la imagen: le llega montada en
# /root/ssh_montado al arrancar (docker-compose.yml).
RUN encontrados="$(find /app \( -path /app/secrets -o -name 'id_rsa*' -o -name 'id_ed25519*' \
        -o -name 'id_ecdsa*' -o -name '.env' -o -name '*.env' -o -name '.env.*' \) \
        ! -name '*.pub' ! -name '.env.example' -print)"; \
    if [ -n "$encontrados" ]; then \
        echo "ERROR: la imagen llevaría secretos dentro (revisa .dockerignore, spec 006):" >&2; \
        echo "$encontrados" >&2; \
        exit 1; \
    fi

# Sin carpeta secrets: nada la usa, la clave llega montada en /root.
RUN mkdir -p uploads algoritmos \
    && chmod +x scripts/docker-entrypoint.sh

# Punto de montaje del socket del banco de pruebas. Se crea aqui, y con dueno
# nobody, porque un volumen con nombre hereda los permisos de la ruta que
# exista en la imagen la primera vez que se crea: sin esto, el volumen seria de
# root y uvicorn --uds no podria crear el socket corriendo como nobody.
RUN mkdir -p /sock && chown 65534:65534 /sock

# El contenedor del banco de pruebas (docker-compose.yml, servicio "banco")
# construye esta misma imagen con PURGAR_CATALOGO=1. El sandbox solo necesita
# app/ y referencia/ para ejecutar el algoritmo que le llega: no debe llevarse
# dentro el catalogo, porque ahi tambien viven los algoritmos PRIVADOS de otros
# desarrolladores y no hay razon para que un script no verificado pueda leerlos.
#
# Se hace con un ARG y no con un Dockerfile aparte para que las capas caras
# --apt, pip, la descarga de smina-- se compartan entre las dos imagenes.
ARG PURGAR_CATALOGO=0
RUN if [ "$PURGAR_CATALOGO" = "1" ]; then rm -rf /app/algoritmos/* /app/uploads/*; fi

EXPOSE 8000

# El entrypoint solo añade un paso: registrar la clave SSH del clúster en
# known_hosts cuando EXECUTION_MODE=slurm (ver scripts/docker-entrypoint.sh).
# En modo local no hace nada y ejecuta el comando tal cual.
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]

# Sin --reload y con varios procesos.
#
# --reload no es solo "innecesario en producción": vigila *.py bajo el
# directorio de trabajo, y algoritmos/ está montado como volumen, así que
# CADA subida de un algoritmo reiniciaba el backend y cortaba las peticiones
# en vuelo. Además dejaba la API en un único proceso, donde cualquier endpoint
# síncrono pesado bloqueaba a todos los usuarios a la vez.
#
# scripts/migrate.py espera a que la base de datos acepte conexiones y crea el
# esquema una sola vez, antes de levantar los workers: con --workers N, los N
# procesos ejecutarían create_all() en paralelo al importar app.main, y ese DDL
# concurrente puede bloquearse entre sí en PostgreSQL.
CMD ["sh", "-c", "python scripts/migrate.py && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4"]
